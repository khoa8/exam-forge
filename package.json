{
  "name": "exam-forge",
  "version": "0.1.0",
  "private": true,
  "description": "ExamForge — turn study material into an adaptive exam coach",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:smoke:prod": "npm run build && playwright test --config playwright.prod-smoke.config.ts",
    "db:reset": "node scripts/reset-db.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "build:hosted": "vite build --config vite.hosted.config.ts",
    "dev:hosted": "vite --config vite.hosted.config.ts",
    "deploy:hosted": "npm run build:hosted && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.137.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    }
  }
}
