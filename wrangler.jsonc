{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "examforge-beta",
  "main": "src/worker/keepalive.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist-hosted",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    "crons": ["0 0,8,16 * * *"]
  }
}
