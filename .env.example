# ExamForge environment configuration (copy to .env.local — never commit .env.local)

# Provider selection: "auto" (default) | "demo" | "glm"
# "demo" forces the deterministic offline provider (no API key, no network).
# "auto" uses GLM only if EXAMFORGE_LLM_API_KEY is set, otherwise demo.
EXAMFORGE_PROVIDER=auto

# Optional GLM (OpenAI-compatible) adapter. Leave empty to use the demo provider.
# Get a key from your GLM provider account — never commit real keys.
EXAMFORGE_LLM_API_KEY=
# Optional overrides (timeout must be an integer between 1000 and 300000 ms):
# EXAMFORGE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EXAMFORGE_LLM_MODEL=glm-4-flash
# EXAMFORGE_LLM_TIMEOUT_MS=30000

# SQLite database location (default: .data/examforge.sqlite)
# EXAMFORGE_DB_PATH=
